{
  "schemaVersion": 1,
  "tool": "sample_signed",
  "version": "1.0.0",
  "released": "2026-04-01",
  "channel": "stable",
  "install_methods": [
    {
      "name": "tarball",
      "method_kind": "binary-tarball",
      "platform": {
        "os": ["debian", "ubuntu"],
        "arch": ["amd64", "arm64"]
      },
      "verification": {
        "tier": 1,
        "algorithm": "gpg",
        "checksum_manifest": true,
        "checksum_url_template": "https://example.invalid/sample-signed/{version}/SHASUMS256.txt",
        "gpg_keyring": "keyrings/sample-signed.asc",
        "signature_url_template": "https://example.invalid/sample-signed/{version}/SHASUMS256.txt.sig"
      },
      "source_url_template": "https://example.invalid/sample-signed/{version}/sample-{version}-linux-{arch}.tar.xz",
      "dependencies": [
        { "tool": "ca_certificates" },
        { "tool": "gnupg" }
      ]
    }
  ],
  "metadata": {
    "added_at": "2026-10-27T00:00:00Z",
