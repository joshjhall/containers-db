        "sigstore_issuer": "https://token.actions.githubusercontent.com"
      },
      "source_url_template": "https://example.invalid/sample-signed/{version}/sample-{version}-linux-{arch}.tar.gz",
      "dependencies": [
        { "tool": "ca_certificates" }
      ]
    }
  ],
