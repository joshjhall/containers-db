{
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "[shellscript]": { "editor.defaultFormatter": "foxundermoon.shell-format" },
  "shellformat.flag": "-i 4 -ci",
  "shellcheck.customArgs": ["--severity=warning"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
  },
  "[json]": { "editor.defaultFormatter": "dprint.dprint" },
  "[jsonc]": { "editor.defaultFormatter": "dprint.dprint" },
  "[yaml]": { "editor.defaultFormatter": "dprint.dprint" },
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
  "files.trimTrailingWhitespace": true
}
