          "kind": "component_add"
        },
        {
          "component": "rust-analyzer",
          "kind": "component_add"
        },
        {
          "component": "clippy",
          "kind": "component_add"
        },
        {
          "component": "rustfmt",
          "kind": "component_add"
        }
      ],
