{
  "channel": "stable",
  "install_methods": [
    {
      "bin_source_dir": "cargo/bin",
      "binaries": [
        "rustc",
        "cargo",
        "rustup",
        "rust-analyzer",
        "rustfmt",
        "clippy-driver"
      ],
      "cache_dirs": {
        "CARGO_HOME": "cargo",
        "RUSTUP_HOME": "rustup"
      },
      "dependencies": [
        {
          "tool": "ca_certificates"
        },
        {
          "tool": "gcc"
        },
        {
          "tool": "libc_dev"
        },
        {
          "tool": "util_linux",
          "platforms": [
            "rhel"
          ],
          "purpose": "build"
        }
      ],
      "invoke": {
        "args": [
          "-y",
          "--default-toolchain",
          "1.91.1",
          "--profile",
          "default"
        ],
        "env": {
          "CARGO_HOME": "/cache/cargo",
          "RUSTUP_HOME": "/cache/rustup"
        }
      },
      "method_kind": "script-installer",
      "name": "rustup-init",
      "platform": {
        "arch": [
          "amd64",
          "arm64"
        ],
        "os": [
          "debian",
          "ubuntu",
          "rhel"
        ]
      },
      "post_install": [
        {
          "component": "rust-src",
          "kind": "component_add"
        },
        {
          "component": "rust-analyzer",
          "kind": "component_add"
        },
        {
          "component": "clippy",
          "kind": "component_add"
        },
        {
          "component": "rustfmt",
          "kind": "component_add"
        }
      ],
