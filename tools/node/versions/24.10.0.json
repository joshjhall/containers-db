      "platform": {
        "os": "alpine",
        "arch": [
          "amd64",
          "arm64"
        ]
      },
      "source_url_template": "https://nodejs.org/dist/v{version}/node-v{version}.tar.xz",
      "strip_components": 1,
      "prefix": "/usr/local",
      "build_steps": [
        {
          "command": "./configure",
          "args": [
            "--prefix=/usr/local"
          ]
        },
        {
          "command": "make",
          "args": [
            "-j{nproc}"
          ]
        },
        {
          "command": "make",
          "args": [
            "install"
          ]
        }
      ],
      "dependencies": [
        {
          "tool": "ca_certificates"
