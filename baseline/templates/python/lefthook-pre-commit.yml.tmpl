
    ruff-format:
      glob: "*.py"
      skip:
        - run: "! command -v ruff >/dev/null 2>&1"
      run: just fmt-py {staged_files}
      stage_fixed: true

    ruff-check:
      glob: "*.py"
      skip:
        - run: "! command -v ruff >/dev/null 2>&1"
      run: just lint-py {staged_files}
