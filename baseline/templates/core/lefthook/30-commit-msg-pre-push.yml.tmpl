
commit-msg:
  commands:
    conform:
      skip:
        - run: "! command -v conform >/dev/null 2>&1"
      run: just lint-commit-msg {1}

pre-push:
  parallel: true
  commands:
    dprint-check:
      skip:
        - run: "! command -v dprint >/dev/null 2>&1"
      run: just fmt-config-check

    taplo-check:
      skip:
        - run: "! command -v taplo >/dev/null 2>&1"
      run: just fmt-toml-check

    typos:
      skip:
        - run: "! command -v typos >/dev/null 2>&1"
      run: just lint-typos

    tests:
      run: just test
