{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "The CI image tag is <codename>-<YYYYMMDD>-slim: bump the date, never the codename.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["debian"],
      "versioning": "regex:^(?<compatibility>[a-z]+)-(?<major>\\d{8})-slim$"
    }
  ]
}
