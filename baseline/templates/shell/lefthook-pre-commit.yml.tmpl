
    shellcheck:
      glob: "*.sh"
      skip:
        - run: "! command -v shellcheck >/dev/null 2>&1"
      run: just lint-sh {staged_files}

    shfmt:
      glob: "*.sh"
      skip:
        - run: "! command -v shfmt >/dev/null 2>&1"
      run: just fmt-sh {staged_files}
      stage_fixed: true
